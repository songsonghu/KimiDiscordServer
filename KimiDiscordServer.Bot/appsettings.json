{
  "Discord": {
    "Token": "",
    "RequireBotMention": true,
    "AllowDirectMessages": true,
    "AllowedChannelIds": [],
    "MaxAttachmentBytes": 4194304,
    "MaxTextDocumentBytes": 262144,
    "MaxDiscordMessageLength": 1900
  },
  "Ai": {
    "DefaultProvider": "Claude",
    "SystemPrompt": "You are a helpful assistant replying inside Discord. Keep answers clear, practical, and in the same language as the user's latest request.",
    "Claude": {
      "ApiKey": "",
      "Model": "claude-3-5-sonnet-latest",
      "Endpoint": "https://api.anthropic.com/v1/messages",
      "MaxOutputTokens": 1024
    },
    "Kimi": {
      "ApiKey": "",
      "Model": "moonshot-v1-8k",
      "Endpoint": "https://api.moonshot.cn/v1/chat/completions",
      "MaxOutputTokens": 1024
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Discord": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
